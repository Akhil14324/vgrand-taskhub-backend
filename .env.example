PORT=5000
NODE_ENV=development

# --- Database -----------------------------------------------------------------
# Supabase: DATABASE_URL = pooled (port 6543, PgBouncer), DIRECT_URL = direct (port 5432).
# Railway / plain Postgres: set both to the same URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskhub
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/taskhub
# TLS is turned on automatically for Render/Supabase/Railway/Neon hosts.
# Force it on/off with true/false if your host isn't detected.
DATABASE_SSL=

# --- Auth ---------------------------------------------------------------------
JWT_SECRET=change-this-to-a-strong-secret-key
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed web origins (your PWA URL), or * during setup.
CLIENT_URL=http://localhost:8081

# Business-day boundaries and to-do reminder times use this timezone.
APP_TIMEZONE=Asia/Kolkata

# --- Organisation seed (runs once on first start) --------------------------------
# Creates VGrand Family Restaurant, VGrand Infra, VTech, BVL Mines & Minerals and the
# leadership + business heads. New accounts must change this password at first login.
SEED_ORGANIZATION=true
SEED_DEFAULT_PASSWORD=Vgrand@2026

# --- Push notifications (Firebase Cloud Messaging) ------------------------------
# Firebase console → Project settings → Service accounts → Generate new private key.
# Either paste the whole JSON (or base64 of it) into FIREBASE_SERVICE_ACCOUNT ...
FIREBASE_SERVICE_ACCOUNT=
# ... or set the three fields individually (keep the \n sequences in the key).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Uploads ------------------------------------------------------------------
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=5242880
UPLOAD_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Run with Claude (optional; see README "Run with Claude") ---------------------------------------
# Only these usernames (comma separated) can see or use Claude. Default: akhil
CLAUDE_ALLOWED_USERNAMES=akhil
# Long random string. The same value goes into every project repo's Actions secret CLAUDE_WEBHOOK_SECRET.
CLAUDE_WEBHOOK_SECRET=
# GitHub token per repo owner (a fine-grained token only covers ONE owner): Actions, Contents and
# Pull requests = read & write. CLAUDE_GITHUB_TOKEN_<OWNER> (owner upper-cased) wins over CLAUDE_GITHUB_TOKEN.
CLAUDE_GITHUB_TOKEN=
CLAUDE_GITHUB_TOKEN_VARUNKUMAR06011=
# Projects Claude can work on: key=owner/repo, comma separated, one entry per project.
CLAUDE_REPOS=mobile=Akhil14324/Taskhub-mobile,backend=Akhil14324/vgrand-taskhub-backend,vgrand-engine=Akhil14324/vgrand-engine,softshapeai=varunkumar06011/Softshapeai,softshape-backend=varunkumar06011/softshape-backend,hspl-erp=varunkumar06011/Final-hspl-erp,print-agent=varunkumar06011/softshape-print-agent,infra-web=varunkumar06011/vgrand-infra-web
# Optional: force one target branch for all repos (default: each repo's own default branch).
CLAUDE_BASE_BRANCH=
# Optional: default is https://$RAILWAY_PUBLIC_DOMAIN/api/claude/callback
CLAUDE_CALLBACK_URL=
