#!/bin/sh
# Nothing reaches GitHub (and so Railway) unless the tests pass and the server's files load. Added 2026-11-14.
# To skip in an emergency: git push --no-verify.
remote_is_main=0
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/main) remote_is_main=1 ;; esac
done
[ "$remote_is_main" = 1 ] || exit 0
echo "pre-push: running the tests before pushing to main..." >&2
log=$(mktemp)
if ! npm test >"$log" 2>&1; then
  echo "pre-push: tests FAILED. Nothing was pushed." >&2
  tail -30 "$log" >&2; rm -f "$log"; exit 1
fi
# Every source file must at least parse (a route with a syntax error would crash the server on start).
bad=0
for f in $(git ls-files 'src/*.js'); do
  node --check "$f" 2>>"$log" || bad=1
done
if [ "$bad" = 1 ]; then
  echo "pre-push: a file does not parse. Nothing was pushed." >&2
  tail -20 "$log" >&2; rm -f "$log"; exit 1
fi
rm -f "$log"
echo "pre-push: tests passed and every file parses." >&2
exit 0
